# Copy to .env and fill in. Never commit .env.
APP_ENV=development

# Local defaults (docker-compose overrides these for the api container)
DATABASE_URL=postgresql+psycopg://autohub:autohub@localhost:5432/autohub
REDIS_URL=redis://localhost:6379/0

# Groq (Phase 1+)
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Twilio WhatsApp sandbox (Phase 2/4)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Run engine
# queue = Redis worker runs jobs; inline = run inside the API (handy for debugging)
RUN_MODE=queue
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3

# Lead handler: replies below this confidence go to the approval queue
AUTO_SEND_CONFIDENCE=0.80

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173
