# Copy to .env and fill in. Never commit .env.
APP_ENV=development

# Local defaults (docker-compose overrides these for the api container)
DATABASE_URL=postgresql+psycopg://autohub:autohub@localhost:5432/autohub
REDIS_URL=redis://localhost:6379/0

# Groq (Phase 1+)
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# WhatsApp (see docs/WHATSAPP_SETUP.md): meta = WhatsApp Cloud API, twilio = Twilio sandbox
WHATSAPP_PROVIDER=meta
# Meta WhatsApp Cloud API
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
# make up any long random string; you type the same one into Meta's webhook settings
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
# Twilio (alternative)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# dry_run records replies without sending; live really sends through the provider
SEND_MODE=dry_run
# live sends go ONLY to these numbers (comma-separated). Keep it to your own number while testing.
LIVE_SEND_ALLOWLIST=
# the public address Twilio calls, e.g. https://<your-codespace>-8000.app.github.dev (optional:
# worked out from proxy headers when empty)
PUBLIC_BASE_URL=
TWILIO_VALIDATE_SIGNATURE=true

# Email through Gmail (see docs/EMAIL_SETUP.md). Use a Gmail account made for AutoHub, not your personal one:
# AutoHub reads its inbox and replies to what it finds there.
SMTP_USERNAME=
# a Google app password (16 letters), not your normal password
SMTP_PASSWORD=
EMAIL_FROM_NAME=flowpath
IMAP_FOLDER=INBOX
# live emails go ONLY to these addresses (comma-separated). Empty = reply to anyone who writes in.
EMAIL_SEND_ALLOWLIST=

# Daily digest goes to these (either or both)
DIGEST_WHATSAPP_TO=
DIGEST_EMAIL_TO=

# Run engine
# queue = Redis worker runs jobs; inline = run inside the API (handy for debugging)
RUN_MODE=queue
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
# rate limits (429) get more attempts; Groq's free plan allows 8,000 tokens/minute on gpt-oss-20b
LLM_RATE_LIMIT_RETRIES=6

# Lead handler
GROQ_DRAFT_MODEL=openai/gpt-oss-120b
# replies below this confidence go to the approval queue
AUTO_SEND_CONFIDENCE=0.80
# languages whose replies are always reviewed by a person (until evals prove them reliable)
REVIEW_LANGUAGES=urdu,arabic
# set a long random value before exposing the API; callers send it as header X-AutoHub-Key
INBOUND_API_KEY=

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173
