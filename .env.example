# Copy to .env and fill in. Never commit .env.
APP_ENV=development

# Local defaults (docker-compose overrides these for the api container)
DATABASE_URL=postgresql+psycopg://autohub:autohub@localhost:5432/autohub
REDIS_URL=redis://localhost:6379/0

# Groq (Phase 1+)
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Twilio WhatsApp sandbox (Phase 2/4)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Run engine
# queue = Redis worker runs jobs; inline = run inside the API (handy for debugging)
RUN_MODE=queue
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
# rate limits (429) get more attempts; Groq's free plan allows 8,000 tokens/minute on gpt-oss-20b
LLM_RATE_LIMIT_RETRIES=6

# Lead handler
GROQ_DRAFT_MODEL=openai/gpt-oss-120b
# replies below this confidence go to the approval queue
AUTO_SEND_CONFIDENCE=0.80
# languages whose replies are always reviewed by a person (until evals prove them reliable)
REVIEW_LANGUAGES=urdu,arabic
# set a long random value before exposing the API; callers send it as header X-AutoHub-Key
INBOUND_API_KEY=

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173
